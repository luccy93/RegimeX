# =============================================================================
# RegimeX API — Environment Configuration Template
# =============================================================================
#
# Copy this file to .env and populate the values for your environment:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# This .env.example file IS committed — it is the configuration contract.
#
# All variable names use the REGIMEX_ prefix (set in pyproject.toml via
# pydantic-settings env_prefix).
# =============================================================================

# ---------------------------------------------------------------------------
# Application Identity
# ---------------------------------------------------------------------------
REGIMEX_ENV=development
# Allowed values: development | test | production
# Default: development

REGIMEX_DEBUG=false
# Set to true only during local development. NEVER true in production.

REGIMEX_APP_NAME=RegimeX API
REGIMEX_APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
REGIMEX_API_V1_PREFIX=/api/v1

REGIMEX_ALLOWED_ORIGINS=http://localhost:3000
# In production, set this to your actual frontend domain(s).
# Comma-separated if using a list override via env.

# ---------------------------------------------------------------------------
# Database (PostgreSQL + TimescaleDB)
# Implemented in V05 — Market Data Engine
# ---------------------------------------------------------------------------
REGIMEX_DATABASE_URL=postgresql+asyncpg://regimex:changeme@localhost:5432/regimex_dev
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# PRODUCTION: Supply a real database URL with credentials managed by your
# secret management solution (e.g., AWS Secrets Manager, Vault, Doppler).
# DO NOT hardcode production credentials here or in .env files committed to Git.

REGIMEX_DATABASE_POOL_SIZE=10
REGIMEX_DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis
# Implemented in V05
# ---------------------------------------------------------------------------
REGIMEX_REDIS_URL=redis://localhost:6379/0
# PRODUCTION: Use Redis with AUTH enabled and TLS if accessible over network.

# ---------------------------------------------------------------------------
# Security
# REQUIRED in production — no safe defaults exist
# ---------------------------------------------------------------------------
REGIMEX_SECRET_KEY=CHANGE_ME_in_production_use_32+_random_bytes
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
# This value signs JWT tokens. If it changes, all existing tokens are invalidated.
# PRODUCTION: Inject via your CI/CD secret injection, never commit a real value.

REGIMEX_JWT_ALGORITHM=HS256
REGIMEX_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Background Workers (Celery)
# Implemented in V05
# ---------------------------------------------------------------------------
REGIMEX_CELERY_BROKER_URL=redis://localhost:6379/1
REGIMEX_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
REGIMEX_LOG_LEVEL=INFO
# Allowed: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG locally for verbose output.

REGIMEX_LOG_FORMAT=text
# Allowed: json (production, structured) | text (development, human-readable)
