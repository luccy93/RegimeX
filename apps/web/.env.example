# =============================================================================
# RegimeX Web — Environment Configuration Template
# =============================================================================
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# This .env.example IS committed — it is the configuration contract.
#
# Next.js environment variable rules:
#   NEXT_PUBLIC_* : Exposed to the browser at build time. Safe for non-secrets.
#   Non-prefixed  : Server-side only. Never sent to the browser.
# =============================================================================

# ---------------------------------------------------------------------------
# API Connection
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Points to the RegimeX FastAPI backend.
# Development: http://localhost:8000 (default)
# Production: Set to your production API URL (e.g., https://api.regimex.io)
# This is intentionally PUBLIC — it is the API base URL, not a secret.

# ---------------------------------------------------------------------------
# Application identity (browser-safe)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=RegimeX
NEXT_PUBLIC_APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Feature flags (optional, for future use)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FEATURE_AI_RESEARCH=false
# NEXT_PUBLIC_FEATURE_BACKTESTING=false

# ---------------------------------------------------------------------------
# Server-side only (never NEXT_PUBLIC_)
# These values are only accessible in Next.js server components and API routes.
# NEVER put secrets in NEXT_PUBLIC_ variables.
# ---------------------------------------------------------------------------

# Example server-side variable (add real values in .env.local, never here):
# INTERNAL_API_SECRET=              # Server-to-server shared secret (V15)
