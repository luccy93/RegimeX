# =============================================================================
# RegimeX Web — Environment Configuration Template
# Volume 18 — Commit 01
# =============================================================================
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# This .env.example IS committed — it is the configuration contract.
#
# Next.js environment variable rules:
#   NEXT_PUBLIC_* : Exposed to the browser at build time. Safe for non-secrets only.
#   Non-prefixed  : Server-side only. Never sent to the browser.
# =============================================================================

# ---------------------------------------------------------------------------
# API Connection (Browser-Safe Base URL)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supported alias:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Points to the RegimeX FastAPI backend.
# Development: http://localhost:8000 (default)
# Production: Set to your production API URL (e.g., https://api.regimex.io)
# This is intentionally PUBLIC — it is the API base URL, not a secret.

# ---------------------------------------------------------------------------
# Application Identity (Browser-Safe)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=RegimeX
NEXT_PUBLIC_APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Security Boundary
# ---------------------------------------------------------------------------
# NEVER put backend secrets in NEXT_PUBLIC_* variables.
# The web application does NOT contain:
#   - AUTH_JWT_SECRET
#   - Database credentials
#   - Provider API keys
# All privileged actions are mediated through the RegimeX FastAPI service.
