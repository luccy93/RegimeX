# =============================================================================
# RegimeX — Production Environment Configuration Template
# infra/.env.production.example
# =============================================================================
#
# Production configuration contract for RegimeX.
# Populate these variables in your secure production secrets manager
# (e.g., AWS Secrets Manager, HashiCorp Vault, Doppler, or platform env).
#
# NEVER commit a real .env or .env.production file containing secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment & Port Binding
# -----------------------------------------------------------------------------
REGIMEX_ENV=production
REGIMEX_DEBUG=false
PORT=8000
WEB_PORT=3000
API_BIND_IP=127.0.0.1
WEB_BIND_IP=0.0.0.0

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 + TimescaleDB)
# -----------------------------------------------------------------------------
# Supply a fully qualified connection URL with production credentials.
# Insecure defaults ("changeme", "postgres:postgres") are rejected at startup.
REGIMEX_DB_NAME=regimex_prod
REGIMEX_DB_USER=regimex
REGIMEX_DB_PASSWORD=generate_a_secure_random_db_password_min_24_chars
REGIMEX_DATABASE_URL=postgresql+asyncpg://regimex:generate_a_secure_random_db_password_min_24_chars@db:5432/regimex_prod

# Database Connection Pool Tuning
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Redis Configuration (Cache & Message Broker)
# -----------------------------------------------------------------------------
# Redis is used for async workers (Celery) and rate-limiting cache.
# Core API endpoints operate safely even if Redis is unconfigured or restarting.
REGIMEX_REDIS_URL=redis://redis:6379/0
REGIMEX_CELERY_BROKER_URL=redis://redis:6379/1
REGIMEX_CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_CONNECT_TIMEOUT=5

# -----------------------------------------------------------------------------
# Security & Authentication (MANDATORY IN PRODUCTION)
# -----------------------------------------------------------------------------
# JWT signing key — MUST be a cryptographically secure string of at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REGIMEX_SECRET_KEY=generate_a_secure_random_hex_secret_key_at_least_32_chars
REGIMEX_JWT_ALGORITHM=HS256
REGIMEX_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional JWT claims
# REGIMEX_AUTH_JWT_ISSUER=https://api.regimex.io
# REGIMEX_AUTH_JWT_AUDIENCE=https://app.regimex.io

# Request Boundary Limits
REGIMEX_MAX_REQUEST_BODY_BYTES=10485760

# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
# Comma-separated list of exact allowed browser origins.
# Wildcards ('*') are strictly prohibited in production.
REGIMEX_ALLOWED_ORIGINS=https://app.yourdomain.com,https://regimex.yourdomain.com

# -----------------------------------------------------------------------------
# Frontend Client Public API URL
# -----------------------------------------------------------------------------
# The browser-accessible URL of the API.
# MUST NOT point to internal container hostnames like "http://api:8000"
# because client browsers outside the Docker network cannot resolve them.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# -----------------------------------------------------------------------------
# Observability & Structured Logging
# -----------------------------------------------------------------------------
REGIMEX_LOG_FORMAT=json
REGIMEX_LOG_LEVEL=INFO

# Data & Model Health Thresholds
REGIMEX_DATA_FRESHNESS_THRESHOLD=86400
REGIMEX_DATA_STALE_THRESHOLD=259200
REGIMEX_MODEL_HEALTH_WINDOW=100
REGIMEX_MODEL_LOW_CONFIDENCE_THRESHOLD=0.5
REGIMEX_MODEL_DRIFT_THRESHOLD=0.25
REGIMEX_DATA_DRIFT_THRESHOLD=0.25
REGIMEX_OBSERVABILITY_HISTORY_LIMIT=50

# -----------------------------------------------------------------------------
# AI Research Assistant (Optional)
# -----------------------------------------------------------------------------
# 'mock' (default — offline, deterministic, zero external API keys needed)
# 'openai' (external model provider; requires REGIMEX_AI_API_KEY)
REGIMEX_AI_PROVIDER=mock
REGIMEX_AI_MODEL=gpt-4o-mini
# REGIMEX_AI_API_KEY=sk-...
# REGIMEX_AI_BASE_URL=
REGIMEX_AI_TIMEOUT=30
REGIMEX_AI_MAX_TOKENS=2000
