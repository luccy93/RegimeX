# =============================================================================
# RegimeX — Root Environment Configuration Template
# =============================================================================
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env to version control.
#
# -----------------------------------------------------------------------------
# AI Research Assistant (V21)
# -----------------------------------------------------------------------------
REGIMEX_AI_PROVIDER=mock
REGIMEX_AI_MODEL=gpt-4o-mini
REGIMEX_AI_API_KEY=
REGIMEX_AI_BASE_URL=
REGIMEX_AI_TIMEOUT=30
REGIMEX_AI_MAX_TOKENS=2000

# -----------------------------------------------------------------------------
# API & Core Settings
# -----------------------------------------------------------------------------
REGIMEX_ENV=development
REGIMEX_DEBUG=false
REGIMEX_DATABASE_URL=postgresql+asyncpg://regimex:changeme@localhost:5432/regimex_dev
REGIMEX_REDIS_URL=redis://localhost:6379/0
REGIMEX_AUTH_JWT_SECRET=insecure-dev-secret-replace-in-production-min32chars!

# -----------------------------------------------------------------------------
# Observability & Health Monitoring (V23 Commit 02)
# -----------------------------------------------------------------------------
REGIMEX_DATA_FRESHNESS_THRESHOLD=86400
REGIMEX_DATA_STALE_THRESHOLD=259200
REGIMEX_MODEL_HEALTH_WINDOW=100
REGIMEX_MODEL_LOW_CONFIDENCE_THRESHOLD=0.5
REGIMEX_MODEL_DRIFT_THRESHOLD=0.25
REGIMEX_DATA_DRIFT_THRESHOLD=0.25
REGIMEX_OBSERVABILITY_HISTORY_LIMIT=50

