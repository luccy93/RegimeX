# =============================================================================
# RegimeX — .gitignore
# =============================================================================
# This file covers Python, Node.js, Docker, IDE, coverage, logs, and secrets.
# Never ignore .env.example — that template is intentionally source-controlled.
# =============================================================================

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
ENV/
env/
.env/
env.bak/
venv.bak/
.python-version

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pytest
.pytest_cache/
.cache/

# Coverage
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
*.cover

# Ruff cache
.ruff_cache/

# Type checking
.pytype/
pyrightconfig.json

# ---------------------------------------------------------------------------
# Node.js / Next.js
# ---------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnp.js
.pnp/
.yarnrc.yml

# Build output
.next/
out/
dist/
build/
.cache/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Environment files — NEVER commit real secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# DO NOT add .env.example — that file is intentionally committed

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Databases / data files
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql.gz
postgres-data/
redis-data/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# OS and IDE files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ---------------------------------------------------------------------------
# Generated artifacts / temp files
# ---------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej

# Jupyter Notebooks (not part of this project)
.ipynb_checkpoints/
*.ipynb

# ---------------------------------------------------------------------------
# Security — additional safeguards
# ---------------------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# ---------------------------------------------------------------------------
# Quality tooling artefacts (V04 — never commit these)
# ---------------------------------------------------------------------------
# mypy cache
.mypy_cache/

# Ruff cache
.ruff_cache/

# pytest cache
.pytest_cache/

# Coverage output
.coverage
coverage.xml
htmlcov/

# TypeScript incremental build info
tsconfig.tsbuildinfo

# pre-commit cache
.pre-commit-cache/

# Next.js build output
.next/
out/
